    "code": "<style>.sjv{position:relative;margin-top:6px}.sjv .vsl-track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding-bottom:6px;-ms-overflow-style:none;scrollbar-width:none}.sjv .vsl-track::-webkit-scrollbar{display:none}.sjv .vsl-card{flex:0 0 236px;margin:0;scroll-snap-align:start}.sjv .vsl-thumb{position:relative;aspect-ratio:9/16;border-radius:12px;overflow:hidden;background:#111}.sjv .vsl-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0;display:block;background:#000}.sjv .vsl-thumb iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#000}.sjv .vsl-thumb:after{content:\"\";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(0deg,rgba(0,0,0,.28) 0%,rgba(0,0,0,0) 45%)}.sjv .vsl-thumb[data-open]:after{display:none}.sjv .vsl-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2;width:54px;height:54px;border-radius:50%;border:0;cursor:pointer;padding:0;background:rgba(255,255,255,.92);box-shadow:0 6px 20px rgba(0,0,0,.3);transition:transform .16s ease,background .16s ease}.sjv .vsl-play:after{content:\"\";display:block;margin:0 auto;width:0;height:0;border-left:17px solid #000;border-top:11px solid transparent;border-bottom:11px solid transparent;transform:translateX(3px)}.sjv .vsl-play:hover{background:#fff;transform:translate(-50%,-50%) scale(1.07)}.sjv .vsl-play:focus-visible{outline:3px solid #D4232B;outline-offset:3px}.sjv figcaption{margin-top:12px}.sjv figcaption b{display:block;font-size:14.5px;font-weight:500;color:#000}.sjv figcaption span{display:block;margin-top:3px;font-size:13px;line-height:1.36;color:#636A72}.sjv .vsl-btn{position:absolute;top:34%;z-index:5;width:40px;height:40px;border-radius:50%;border:1px solid #E3E5E8;background:#fff;color:#636A72;font:inherit;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.16s}.sjv .vsl-btn:hover{border-color:#D4232B;color:#7E1A22}.sjv .vsl-btn.prev{left:-14px}.sjv .vsl-btn.next{right:-14px}@media(max-width:1240px){.sjv .vsl-btn{display:none}}@media(max-width:700px){.sjv .vsl-play{width:44px;height:44px}.sjv .vsl-play:after{border-left-width:14px;border-top-width:9px;border-bottom-width:9px}}.sj-stories{-ms-overflow-style:none}.sj-stories::-webkit-scrollbar{display:none}</style><div class=\"sjv vslider\"><button class=\"vsl-btn prev\" type=\"button\" aria-label=\"Anterior\">‹</button><div class=\"vsl-track\"></div><button class=\"vsl-btn next\" type=\"button\" aria-label=\"Siguiente\">›</button></div><script>/* TESTIMONIAL VIDEOS - the only place to edit.\n   One entry per video, in running order. vimeo = the video number and h = the privacy hash\n   (both from the share link vimeo.com/<vimeo>/<h>). poster = Builder image asset id for the\n   still. name and line are the caption; every line is an income claim, so it carries **. */\nvar VSL = [\n  {\"vimeo\": \"1240003820\", \"h\": \"0c2c34386f\", \"name\": \"Katie W\", \"line\": \"Trabaja desde casa mientras educa a sus hijos.\", \"poster\": \"d8b90bceb6464755b0b477f0f91b4580\"},\n  {\"vimeo\": \"1240003796\", \"h\": \"e470463372\", \"name\": \"Andre P\", \"line\": \"Emprendedor en serie que viaja por el mundo.\", \"poster\": \"3a52181f6ca245c69f9a56d19be682c6\"},\n  {\"vimeo\": \"1240003832\", \"h\": \"22f72a12b4\", \"name\": \"Brooke T\", \"line\": \"Ganó seis cifras en su primer año, mientras trabajaba tiempo completo.\", \"poster\": \"4f2e697f49cd4180a01f29d263226507\"},\n  {\"vimeo\": \"1240003813\", \"h\": \"4f9cb7c2a6\", \"name\": \"Chris R\", \"line\": \"Agricultor que usa el negocio para invertir en el campo.\", \"poster\": \"e3f918189fea40b48e61cac195399cbc\"},\n  {\"vimeo\": \"1240003789\", \"h\": \"0c8c2b9f4b\", \"name\": \"Denise W\", \"line\": \"Psicóloga gana más de 5 cifras en su primer mes.\", \"poster\": \"7b9aecfcc1ee41218be95c269f5fe8c9\"},\n  {\"vimeo\": \"1240003831\", \"h\": \"9d31812e82\", \"name\": \"Briana M\", \"line\": \"Pudo cubrir su hipoteca en los primeros 30 días.\", \"poster\": \"e16a970adf0e4440ba3ee2d51b0be9d1\"},\n  {\"vimeo\": \"1240003798\", \"h\": \"87ebf396ce\", \"name\": \"Zamara S\", \"line\": \"Construye en su tiempo libre para darse los gustos.\", \"poster\": \"88531704c2a54eadbd7946f3db315b16\"},\n  {\"vimeo\": \"1240003791\", \"h\": \"d3bb9bfe15\", \"name\": \"Judy S\", \"line\": \"Dejó su empleo y logró libertad financiera.\", \"poster\": \"6807dd0f90e64b5db594d9b7baec715c\"}\n];\n(function(){\n  var VIMEO = \"https://player.vimeo.com/video/\";\n  var POSTER = \"https://cdn.builder.io/api/v1/image/assets%2Ffdb4d79bfbfd478d89398007f8c29424%2F\";\n  function esc(t){ var A = String.fromCharCode(38); return String(t).replace(/[&<>\"]/g, function(c){ return A + ({\"&\":\"amp\",\"<\":\"lt\",\">\":\"gt\",\"\\\"\":\"quot\"})[c] + \";\"; }); }\n  function card(v){\n    var src = VIMEO + v.vimeo + \"?h=\" + v.h + \"&autoplay=1&title=0&byline=0&portrait=0&dnt=1\";\n    var cap = v.name ? \"<figcaption><b>\" + esc(v.name) + \"</b>\" + (v.line ? \"<span>\" + esc(v.line) + \"<sup>**</sup></span>\" : \"\") + \"</figcaption>\" : \"\";\n    var img = v.poster ? \"<img src=\\\"\" + POSTER + esc(v.poster) + \"?format=webp&width=400&quality=80\\\" alt=\\\"\\\" decoding=\\\"async\\\" loading=\\\"lazy\\\">\" : \"\";\n    return \"<figure class=\\\"vsl-card\\\"><div class=\\\"vsl-thumb\\\" data-src=\\\"\" + esc(src) + \"\\\">\" + img + \"<button class=\\\"vsl-play\\\" type=\\\"button\\\" aria-label=\\\"Reproducir \" + esc(v.name || \"video\") + \"\\\"></button></div>\" + cap + \"</figure>\";\n  }\n  /* A poster and a button, not a player: the Vimeo iframe is created on click, one at a time. */\n  function openVideo(thumb){\n    var src = thumb.getAttribute(\"data-src\");\n    if (!src || thumb.querySelector(\"iframe\")) return;\n    Array.prototype.forEach.call(document.querySelectorAll(\".sjv .vsl-thumb[data-open]\"), function(o){\n      if (o !== thumb) { o.innerHTML = o.getAttribute(\"data-open\"); o.removeAttribute(\"data-open\"); }\n    });\n    thumb.setAttribute(\"data-open\", thumb.innerHTML);\n    var f = document.createElement(\"iframe\");\n    f.src = src; f.allow = \"autoplay; fullscreen; picture-in-picture\"; f.setAttribute(\"allowfullscreen\", \"\"); f.setAttribute(\"frameborder\", \"0\"); f.title = \"Video\";\n    thumb.innerHTML = \"\"; thumb.appendChild(f);\n  }\n  Array.prototype.forEach.call(document.querySelectorAll(\".sjv\"), function(slider){\n    if (slider.getAttribute(\"data-ready\")) return; slider.setAttribute(\"data-ready\", \"1\");\n    var track = slider.querySelector(\".vsl-track\"); if (!track) return;\n    track.innerHTML = VSL.filter(function(v){ return v && v.vimeo; }).map(card).join(\"\");\n    track.addEventListener(\"click\", function(e){\n      var t = e.target.closest ? e.target.closest(\".vsl-play\") : null;\n      if (t) openVideo(t.parentNode);\n    });\n    function step(dir){ var c = track.querySelector(\".vsl-card\"); var w = c ? c.offsetWidth + 16 : 252; track.scrollBy({ left: dir * w * 2, behavior: \"smooth\" }); }\n    var prev = slider.querySelector(\".vsl-btn.prev\"), next = slider.querySelector(\".vsl-btn.next\");\n    if (prev) prev.addEventListener(\"click\", function(){ step(-1); });\n    if (next) next.addEventListener(\"click\", function(){ step(1); });\n  });\n})();</script>"
