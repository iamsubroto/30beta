en.className=\"ph-screen\";screen.appendChild(inner);var veilT=document.createElement(\"div\");veilT.className=\"ph-veil\";var veilB=document.createElement(\"div\");veilB.className=\"ph-veil bot\";screen.appendChild(veilT);screen.appendChild(veilB);var chassis=document.createElement(\"div\");chassis.className=\"ph-chassis\";chassis.appendChild(screen);thread.appendChild(chassis);document.documentElement.classList.add(\"pin-on\");if(/[?&]phone=static/.test(location.search)){document.documentElement.classList.add(\"pin-static\");return;}rail=document.createElement(\"div\");rail.className=\"pin-rail\";thread.parentNode.insertBefore(rail,thread);rail.appendChild(thread);measure();window.addEventListener(\"scroll\",tick,{passive:true});window.addEventListener(\"resize\",function(){measure();tick();});tick();}function measure(){var scrH=Math.round(Math.min(window.innerHeight*WIN,CAP));screen.style.setProperty(\"--scr-h\",scrH+\"px\");TOP=Math.max(16,Math.round((window.innerHeight-thread.offsetHeight)/2));thread.style.top=TOP+\"px\";maxScroll=Math.max(0,inner.scrollHeight-scrH);rail.style.height=Math.round(thread.offsetHeight+maxScroll*PACE)+\"px\";}function tick(){if(raf)return;raf=requestAnimationFrame(function(){raf=0;if(!started)return;var r=rail.getBoundingClientRect();var travel=rail.offsetHeight-thread.offsetHeight;if(travel<=0)return;var p=(TOP-r.top)/travel;p=p<0?0:(p>1?1:p);inner.style.transform=\"translate3d(0,\"+(-p*maxScroll).toFixed(1)+\"px,0)\";});}if(mq.addEventListener)mq.addEventListener(\"change\",build);else if(mq.addListener)mq.addListener(build);window.addEventListener(\"orientationchange\",function(){setTimeout(function(){if(started){measure();tick();}else{build();}},140);});if(document.fonts&&document.fonts.ready){document.fonts.ready.then(function(){setTimeout(build,60);});}setTimeout(build,700);})();</script>"
