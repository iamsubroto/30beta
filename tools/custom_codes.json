    "code": "<style>\n.sj-page p,.sj-page h1,.sj-page h2,.sj-page h3,.sj-page ul{margin:0}\n.sj-page h1,.sj-page h2,.sj-page h3{font:inherit;letter-spacing:inherit}\n.sj-page sup{font-size:.7em;line-height:0;vertical-align:super;font-weight:400}\n.sj-page h1 sup,.sj-page h2 sup{font-size:.36em;color:#8B929A}\n.sj-proof sup,.sj-soft sup{font-size:.55em;color:#8B929A}\nhtml{scroll-behavior:smooth}\n.sj-why,.sj-packages{scroll-margin-top:72px}\n.sj-page a[href=\"#why\"]{text-decoration:none!important}\n.sj-page a[href=\"#why\"]:after,.sj-down:after{content:\"\\2193\";display:inline-block;margin-left:10px;animation:sjbob 1.6s ease-in-out infinite}\n@keyframes sjbob{0%,100%{transform:translateY(-1px)}50%{transform:translateY(4px)}}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.sj-page a[href=\"#why\"]:after,.sj-down:after{animation:none}}\n@media (max-width:991px){.sj-page .sj-hi{font-style:italic}}\n.sj-proof::-webkit-scrollbar{display:none}\n</style>\n<script>\n(function(){\n  if (window.__sjNav) return; window.__sjNav = 1;\n  /* \"#why\" and \"#packages\" targets. Smooth scroll, then re-check once the page has settled,\n     because the pinned conversation and lazy images change the page height mid-scroll. */\n  function target(id){ return document.querySelector(id === \"why\" ? \".sj-why\" : \".sj-packages\"); }\n  document.addEventListener(\"click\", function(e){\n    var a = e.target && e.target.closest ? e.target.closest('a[href=\"#why\"],a[href=\"#packages\"]') : null;\n    if (!a) return;\n    var t = target(a.getAttribute(\"href\").slice(1)); if (!t) return;\n    e.preventDefault();\n    var reduce = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    t.scrollIntoView({ behavior: reduce ? \"auto\" : \"smooth\", block: \"start\" });\n    [900, 1800, 3000].forEach(function(ms){ setTimeout(function(){\n      if (Math.abs(t.getBoundingClientRect().top - 72) > 40) t.scrollIntoView({ behavior: \"auto\", block: \"st