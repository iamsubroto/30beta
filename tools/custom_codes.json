    "code": "<style>.sjc{--ink:#000;--line:#E3E5E8;--muted:#636A72;--red:#D4232B;--red-deep:#7E1A22;--red-tint:#FDF4F3;--red-line:#EBCBC8}.sjc .thread{display:flex;flex-direction:column;gap:clamp(16px,2.2vw,26px);max-width:560px; width:100%;overflow-x:hidden;overflow-x:clip;padding-block:26px;margin-block:-26px}.sjc .turn{display:flex}.sjc .turn.them{justify-content:flex-end}.sjc .turn .bub{max-width:86%;border-radius:22px;padding:13px 21px;font-size:17px;line-height:1.4; border:1px solid #fff;background:#fff;color:var(--ink); box-shadow:0 10px 26px rgba(20,20,30,.09)}.sjc .turn.her .bub{border-bottom-left-radius:6px}.sjc .turn.them .bub{border-bottom-right-radius:6px;background:#E3E6E9;border-color:#E3E6E9; color:#5D646C;box-shadow:none}.sjc .turn.her.key .bub{background:var(--red-tint);border-color:var(--red-line);color:var(--red-deep); font-weight:500}.sjc .turn.them.key .bub{background:var(--ink);border-color:var(--ink);color:#fff;font-weight:500}.sjc .turn .bub{opacity:0}.sjc .turn.her .bub{transform:translate3d(-26px,8px,0)}.sjc .turn.them .bub{transform:translate3d(26px,8px,0)}.sjc .turn.on .bub{opacity:1;transform:none; transition:opacity .52s ease,transform .58s cubic-bezier(.22,1,.36,1)}.sjc .turn.them.on .bub{transition-delay:.19s}@media(max-width:940px){.sjc .thread{max-width:560px;margin-inline:auto}}@media(max-width:940px){.sjc .turn .bub{font-size:15px;padding:11px 17px}}@media(max-width:900px){.pin-on .sjc .thread{align-items:center;justify-content:flex-start}}@media(max-width:900px){.pin-on .convo.sjc{display:block}}@media(max-width:900px){.pin-on .convo.sjc,.pin-on .sjc .pin-rail,.pin-on .sjc .thread{overflow:visible}}@media(max-width:900px){.sjc .pin-rail{position:relative}}@media(max-width:900px){.pin-on .sjc .thread{position:sticky;top:64px;height:auto;max-width:none; padding-block:0;margin-block:0;display:flex;justify-content:center}}@media(max-width:900px){.pin-static .sjc .thread{position:static;top:auto}}@media(max-width:900px){.pin-static .