    "code": "<style>\n.sjb-chart svg{display:block;width:100%;height:auto;overflow:visible}\n.sjb-chart .g line{stroke:#EFF0F2;stroke-width:1}\n.sjb-chart .lab{font-family:inherit;font-size:11px;fill:#8B929A}\n.sjb-chart .band{fill:#FDF4F3}\n.sjb-chart .bandlab{font-family:inherit;font-size:10px;font-weight:500;letter-spacing:.15em;fill:#7E1A22}\n.sjb-chart .ln{fill:none;stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round}\n.sjb-anim .sjb-chart .band,.sjb-anim .sjb-chart .bandlab,.sjb-anim .sjb-chart .dot{opacity:0}\n.sjb-chart .band{transition:opacity .7s ease .25s}.sjb-chart .bandlab{transition:opacity .7s ease .5s}.sjb-chart .dot{transition:opacity .4s ease}\n.sjb-anim .sjb-chart.on .band,.sjb-anim .sjb-chart.on .bandlab,.sjb-anim .sjb-chart .dot.on{opacity:1}\n</style>\n<div class=\"sjb-chart\" id=\"sjbChart\">\n<svg viewBox=\"0 0 620 340\" role=\"img\" aria-label=\"Gráfica que muestra la vitamina D, el glutatión y el estrógeno cayendo bruscamente entre los 40 y los 55 años\">\n<defs>\n<linearGradient id=\"sjbE\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0%\" stop-color=\"#D4232B\"/><stop offset=\"100%\" stop-color=\"#7E1A22\"/></linearGradient>\n<linearGradient id=\"sjbD\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0%\" stop-color=\"#E5A500\"/><stop offset=\"100%\" stop-color=\"#C98200\"/></linearGradient>\n<linearGradient id=\"sjbG\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0%\" stop-color=\"#64748B\"/><stop offset=\"100%\" stop-color=\"#3F4C5F\"/></linearGradient>\n</defs>\n<rect class=\"band\" x=\"190\" y=\"24\" width=\"180\" height=\"246\" rx=\"4\"/>\n<text class=\"bandlab\" x=\"280\" y=\"18\" text-anchor=\"middle\">DE 35 A 55 AÑOS</text>\n<g class=\"g\"><line x1=\"54\" y1=\"30\" x2=\"596\" y2=\"30\"/><line x1=\"54\" y1=\"90\" x2=\"596\" y2=\"90\"/><line x1=\"54\" y1=\"150\" x2=\"596\" y2=\"150\"/><line x1=\"54\" y1=\"210\" x2=\"596\" y2=\"210\"/><line x1=\"54\" y1=\"270\" x2=\"596\" y2=\"270\"/></g>\n<g class=\"lab\">\n<text x=\"44\" y=\"34\" text-anchor=\"end\">100%</text><text x=\"44\" y=\"94\" text-anchor=\"end\">80</text><text x=\"44\" y=\"154\" text-anchor=\"end\">60</text><text x=\"44\" y=\"214\" text-anchor=\"end\">40</text><text x=\"44\" y=\"274\" text-anchor=\"end\">20</text>\n<text x=\"54\" y=\"292\">20</text><text x=\"144\" y=\"292\">30</text><text x=\"235\" y=\"292\">40</text><text x=\"325\" y=\"292\">50</text><text x=\"415\" y=\"292\">60</text><text x=\"505\" y=\"292\">70</text><text x=\"592\" y=\"292\" text-anchor=\"end\">80</text>\n<text x=\"325\" y=\"314\" text-anchor=\"middle\" style=\"letter-spacing:.14em\">EDAD</text>\n</g>\n<polyline class=\"ln\" stroke=\"url(#sjbD)\" points=\"54,30 144,36 235,48 280,78 325,120 370,156 415,180 505,210 596,231\"/>\n<polyline class=\"ln\" stroke=\"url(#sjbG)\" points=\"54,30 144,39 235,51 280,84 325,120 370,150 415,168 505,192 596,210\"/>\n<polyline class=\"ln\" stroke=\"url(#sjbE)\" points=\"54,30 144,33 190,40 212,62 235,48 258,78 280,108 307,168 325,216 343,246 370,258 415,264 505,267 596,270\"/>\n<circle class=\"dot\" cx=\"596\" cy=\"231\" r=\"5.5\" fill=\"#C98200\" stroke=\"#fff\" stroke-width=\"2.5\"/>\n<circle class=\"dot\" cx=\"596\" cy=\"210\" r=\"5.5\" fill=\"#3F4C5F\" stroke=\"#fff\" stroke-width=\"2.5\"/>\n<circle class=\"dot\" cx=\"596\" cy=\"270\" r=\"5.5\" fill=\"#7E1A22\" stroke=\"#fff\" stroke-width=\"2.5\"/>\n</svg>\n</div>\n<script>\n(function(){\n  var fig = document.getElementById(\"sjbChart\");\n  if (!fig || fig.getAttribute(\"data-ready\")) return;\n  fig.setAttribute(\"data-ready\", \"1\");\n  if (!(\"IntersectionObserver\" in window)) return;\n  if (window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches) return;\n  /* The chart draws itself the first time it scrolls into view: the 35 to 55 band fades in,\n     then the three lines draw left to right, then the end dots appear. If this script never\n     runs, the finished chart simply shows. */\n  var lines = fig.querySelectorAll(\".ln\"), dots = fig.querySelectorAll(\".dot\");\n  var ok = true;\n  Array.prototype.forEach.call(lines, function(l){\n    try { var n = l.getTotalLength(); l.style.strokeDasharray = n; l.style.strokeDashoffset = n; } catch (e) { ok = false; }\n  });\n  if (!ok) { Array.prototype.forEach.call(lines, function(l){ l.style.strokeDashoffset = 0; }); return; }\n  document.documentElement.classList.add(\"sjb-anim\");\n  function draw(){\n    fig.classList.add(\"on\");\n    Array.prototype.forEach.call(lines, function(l, i){\n      setTimeout(function(){\n        l.style.transition = \"stroke-dashoffset 1.5s cubic-bezier(.25,.6,.3,1)\";\n        l.style.strokeDashoffset = 0;\n        setTimeout(function(){ if (dots[i]) dots[i].classList.add(\"on\"); }, 1350);\n      }, i * 260);\n    });\n  }\n  var io = new IntersectionObserver(function(es){\n    es.forEach(function(e){ if (e.isIntersecting){ draw(); io.disconnect(); } });\n  }, { threshold: .08 });\n  io.observe(fig);\n})();\n</script>"
